rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.lower() in ['updatetokendanswacam@gmail.com', 'admin@depotel.id'])
      );
    }

    // Health check endpoint
    match /test/connection {
      allow get: if true;
    }

    // Administrators registry (Only authenticated admins or verified systems can write)
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registered Users list
    // Read: allowed so the application can verify registered users and load roster
    // Write: allowed for registered members and administrators to add/update user profiles permanently
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Monitoring categories and site checklists
    // Read: allowed for operational checklist monitoring
    // Create/Delete: ONLY verified Administrator can create new categories or delete categories
    // Update: Allowed for checklist progress (marking sites, entering tokens, uploading photos)
    match /categories/{categoryId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if true;
    }

    // Documentation photos (Token & SWACAM)
    // Read: allowed for all operational users
    // Create & Update: allowed for photo uploads with valid metadata
    // Delete: strictly restricted to verified Administrator
    match /photos/{photoId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Team invitation links
    match /invites/{inviteId} {
      allow read: if true;
      allow write: if true;
    }

    // Global settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
